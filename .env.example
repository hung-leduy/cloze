# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Cloud tier (D4: Sonnet 5 replaces the superseded claude-3-5-sonnet-20241022) ---
CLOUD_PROVIDER=anthropic
CLOUD_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Local tier (D6: Ollama, not vLLM; qwen3:14b is already on this host) ---
LOCAL_SLM_MODEL=qwen3:14b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_MODELS_HOST=/usr/share/ollama/.ollama
OLLAMA_KEEP_ALIVE=10m

# --- Reference monitor ---
GATEWAY_PORT=5050
STRICT_FAIL_CLOSED=true
CANARY_PREFIX=CANARY_PRIVDEEP_

# Entropy linter. Kept for continuity with the harness spec, but it is NOT the
# mechanism that enforces Invariant 1: measured on representative payloads,
# private English prose scores ~4.16 and the canary format ~4.68, both under
# this threshold. The shingle filter below is what actually does the work.
SHANNON_ENTROPY_THRESHOLD=4.85

# Shingle containment filter (scope doc, Fix 1). Salted-HMAC shingles of C_user
# in a Bloom filter the gateway holds. Deterministic and CI-testable. Whoever
# compromises the gateway can test guessed shingles for membership in C_user
# (THREAT_MODEL.md).
SHINGLE_N_MIN=5
SHINGLE_N_MAX=8
SHINGLE_HIT_THRESHOLD=1
# Generate per install:  python3 -c "import secrets;print(secrets.token_hex(32))"
SHINGLE_HMAC_SALT=

# --- Corpus (D5: user-uploaded xlsx / pdf / md / docx) ---
PRIVDEEP_CORPUS_DIR=./corpus

LOG_LEVEL=INFO
